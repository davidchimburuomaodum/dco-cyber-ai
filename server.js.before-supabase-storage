app.post("/api/chat", async (req, res) => {
  const controller = new AbortController();
  let clientDisconnected = false;
  let chat = null;
  let chats = null;
  let answer = "";

  res.on("close", () => {
    if (!res.writableEnded) {
      clientDisconnected = true;
      controller.abort();
    }
  });

  try {
    const message = String(req.body.message || "").trim();
    const chatId = String(req.body.chatId || "");
    const mode = String(req.body.mode || "general");
    const selectedModel = String(
      req.body.model || process.env.GROQ_MODEL || "openai/gpt-oss-120b"
    );

    if (!Object.prototype.hasOwnProperty.call(aiModeInstructions, mode)) {
      return res.status(400).json({ error: "Invalid AI mode." });
    }

    if (!message || message.length > 4000 || !chatId) {
      return res.status(400).json({
        error: "A valid message and chat ID are required."
      });
    }

    if (!process.env.GROQ_API_KEY) {
      return res.status(503).json({
        error: "Groq API key is not configured."
      });
    }

    const availableModels = await getGroqModels();

    if (!availableModels.includes(selectedModel)) {
      return res.status(400).json({
        error: "That AI model is not available."
      });
    }

    chats = readChats();
    chat = chats.find(c => c.id === chatId);

    if (!chat) {
      return res.status(404).json({
        error: "Chat not found. Start a new chat."
      });
    }

    chat.messages.push({ role: "user", content: message });

    if (chat.title === "New chat") {
      chat.title = message.slice(0, 45) +
        (message.length > 45 ? "..." : "");
    }

    writeChats(chats);

    const conversation = chat.messages.slice(-20).map(m => ({
      role: m.role,
      content: m.content
    }));

    const response = await fetch(
      "https://api.groq.com/openai/v1/chat/completions",
      {
        method: "POST",
        signal: controller.signal,
        headers: {
          Authorization: `Bearer ${process.env.GROQ_API_KEY}`,
          "Content-Type": "application/json"
        },
        body: JSON.stringify({
          model: selectedModel,
          stream: true,
          messages: [
            {
              role: "system",
              content: aiModeInstructions[mode] +
                " Never execute code or commands. Be honest about uncertainty and limitations."
            },
            ...conversation
          ],
          max_tokens: 600,
          temperature: 0.5
        })
      }
    );

    if (!response.ok) {
      const data = await response.json().catch(() => ({}));
      chat.messages.pop();
      writeChats(chats);

      return res.status(502).json({
        error: "Groq AI request failed.",
        details: data.error?.message || "Check the API configuration.",
        status: response.status
      });
    }

    if (!response.body) {
      throw new Error("AI provider did not return a response stream.");
    }

    res.writeHead(200, {
      "Content-Type": "text/event-stream; charset=utf-8",
      "Cache-Control": "no-cache, no-transform",
      "Connection": "keep-alive",
      "X-Accel-Buffering": "no"
    });

    res.flushHeaders();

    const reader = response.body.getReader();
    const decoder = new TextDecoder();
    let buffer = "";
    let streamFinished = false;

    function processLine(line) {
      if (!line.startsWith("data:")) return;

      const payload = line.slice(5).trim();

      if (payload === "[DONE]") {
        streamFinished = true;
        return;
      }

      try {
        const parsed = JSON.parse(payload);
        const token = parsed.choices?.[0]?.delta?.content;

        if (typeof token === "string" && token) {
          answer += token;

          if (!clientDisconnected && !res.destroyed) {
            res.write(
              "event: token\n" +
              "data: " + JSON.stringify({ token }) + "\n\n"
            );
          }
        }
      } catch (error) {
        console.error("Stream parsing error:", error.message);
      }
    }

    try {
      while (!streamFinished && !controller.signal.aborted) {
        const { done, value } = await reader.read();

        if (done) break;

        buffer += decoder.decode(value, { stream: true });

        const lines = buffer.split("\n");
        buffer = lines.pop() || "";

        for (const line of lines) {
          processLine(line.trimEnd());
          if (streamFinished || controller.signal.aborted) break;
        }
      }

      buffer += decoder.decode();

      if (buffer && !controller.signal.aborted) {
        processLine(buffer.trimEnd());
      }
    } catch (error) {
      if (!controller.signal.aborted) throw error;
    } finally {
      reader.releaseLock();
    }

    if (answer.trim()) {
      chat.messages.push({
        role: "assistant",
        content: answer
      });

      chat.updatedAt = Date.now();
      writeChats(chats);
    }

    if (!clientDisconnected && !res.destroyed) {
      res.write(
        "event: done\n" +
        "data: " + JSON.stringify({
          chatId: chat.id,
          title: chat.title,
          stopped: controller.signal.aborted
        }) + "\n\n"
      );
      res.end();
    }

  } catch (error) {
    console.error("Streaming error:", error.message);

    if (answer.trim() && chat && chats) {
      chat.messages.push({
        role: "assistant",
        content: answer
      });
      chat.updatedAt = Date.now();
      writeChats(chats);
    }

    if (!res.headersSent && !res.destroyed) {
      res.status(502).json({
        error: "Unable to connect to AI provider."
      });
    } else if (!res.destroyed) {
      res.write(
        "event: error\n" +
        "data: " + JSON.stringify({
          error: "The AI response was interrupted."
        }) + "\n\n"
      );
      res.end();
    }
  }
});

